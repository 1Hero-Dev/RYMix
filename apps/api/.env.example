# --- Database -----------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/rym?schema=public"

# --- Firebase Admin (verifies ID tokens; see plugins/firebase-auth.ts) ---------
# Path to a service-account JSON. Never commit this file.
GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"

# --- CORS ---------------------------------------------------------------------
# Comma-separated browser origins allowed to call this API. There is no wildcard:
# an origin not listed here is refused.
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"
